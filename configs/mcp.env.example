# Qdrant connection
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT_SECONDS=30
# QDRANT_API_KEY=

# Production tool profile
MOVIE_RAG_PROFILE=dense_v1
MOVIE_RAG_PROFILES_PATH=configs/mcp_profiles_v1.json

# Let FlagEmbedding choose FP16 automatically. Set true/false to override.
# MOVIE_RAG_USE_FP16=true

# Keep the evaluation-only tool hidden from the application LLM by default.
MOVIE_RAG_ENABLE_EXPERIMENTAL_TOOLS=false

# Local development transport
MOVIE_RAG_MCP_TRANSPORT=stdio
