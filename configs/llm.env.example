# Choose the workflow and its versioned configuration.
MOVIE_RAG_LLM_CONFIG=configs/llm_profiles_v1.json
MOVIE_RAG_LLM_WORKFLOW=grounded_v1

# Provider credentials. Set only the provider(s) that you actually use.
# Never commit real keys.
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional OpenAI-compatible gateway. Leave unset for the public OpenAI API.
# OPENAI_BASE_URL=

# Optional per-role profile overrides. Profiles must exist in the JSON registry.
# MOVIE_RAG_PLANNER_LLM_PROFILE=gemini_free
# MOVIE_RAG_CRITIC_LLM_PROFILE=gemini_free
# MOVIE_RAG_ANSWER_LLM_PROFILE=gemini_free
